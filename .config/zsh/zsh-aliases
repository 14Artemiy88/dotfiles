gen_gac() {
	# Цветовые коды для оформления вывода
	local bold="\033[1m"
	local green="\033[32m"
	local blue="\033[34m"
	local red="\033[31m"
	local gray="\033[90m"
	local reset="\033[0m"

	# 1. Проверяем, существует ли целевая директория
	if [ ! -d "app/$1" ]; then
		echo -e "${red}❌ Ошибка:${reset} Директория ${bold}app/$1${reset} не найдена."
		return 1
	fi

	# Переходим в папку проекта
	cd "app/$1" && echo -e "${blue}➜${reset} Зашли в: ${gray}(pwd)${reset}"

	# 2. Проверяем наличие исходного файла main.go
	if [ ! -f "main.go" ]; then
		echo -e "${red}❌ Ошибка:${reset} Файл ${bold}main.go${reset} не найден в этой директории."
		cd - > /dev/null
		return 1
	fi

	# 3. Считываем первую строку файла main.go
	local first_line=$(head -n 1 main.go)

	# Проверяем, является ли строка валидной директивой генерации Go
	if [[ "$first_line" != "//go:generate "* ]]; then
		echo -e "${red}❌ Ошибка:${reset} Первая строка не содержит директиву ${bold}//go:generate${reset}"
		cd - > /dev/null
		return 1
	fi

	# Безопасно обрезаем префикс "//go:generate ", оставляя чистую команду
	local gen_command="${first_line#//go:generate }"

	echo -e "${blue}🔍 Найдена команда:${reset} ${bold}$gen_command${reset}"
	echo -e "${blue}⚙${reset} Запуск генерации ..."

	# Экспортируем необходимые флаги окружения для Go
	export GOFLAGS="-mod=mod"

	# 4. Выполняем команду, отрезаем мусор через sed и пишем результат в main_gen.go
	# Шаблон /^package / делает фильтр универсальным для любых пакетов (main, consumer и т.д.)
	if eval "$gen_command" | sed -n '/^package /,$p' > main_gen.go; then
		echo -e "${blue}⚙${reset} Очистка вывода"

		# Проверяем, не пустой ли файл (на случай, если ключевое слово package не нашлось)
		if [ ! -s main_gen.go ]; then
			echo -e "${red}⚠ Предупреждение:${reset} Файл создан, но ключевое слово ${bold}package${reset} не найдено (файл пуст)."
		else
			echo -e "${green}✔ Успех!${reset} Файл ${bold}main_gen.go${reset} очищен от мусора и успешно сохранен.\n"
		fi
	else
		echo -e "${red}✘ Ошибка выполнения команды генерации!${reset}\n"
		cd - > /dev/null
		return 1
	fi

	# 5. Возвращаемся в исходную рабочую директорию, скрывая системный вывод cd -
	echo -e "${gray}🔙 Возвращаемся в исходный каталог...${reset}"
	cd - > /dev/null
}



alias gac_gen="gen_gac"

myrew_fzf() {
  # Переменная заставляет glab сразу смотреть в сеть, игнорируя локальную папку с @
  local GITLAB_HOST="gitlab.sima-land.ru" # Если у вас корпоративный GitLab, замените на ваш домен, например "gitlab.company.ru"

  GITLAB_HOST=$GITLAB_HOST glab api "groups/264/merge_requests?state=opened&reviewer_username=misyurov_aa&per_page=100" | \
  jq -c '.[] | select(.work_in_progress == false and .draft == false and (.title | startswith("Draft:") | not))' | \
  while read -r mr; do
    project_id=$(echo "$mr" | jq -r '.project_id')
    mr_iid=$(echo "$mr" | jq -r '.iid')

    # Проверяем наличие вашего апрува в этом конкретном МР
    is_approved=$(GITLAB_HOST=$GITLAB_HOST glab api "projects/$project_id/merge_requests/$mr_iid/approvals" 2>/dev/null | jq --arg user "misyurov_aa" '.approved_by[].user.username == $user' 2>/dev/null | grep true)

    if [ -z "$is_approved" ]; then
      # echo "$mr" | jq -r '"[\(.references.full)] \(.title) \t \(.web_url)"'
      echo "$mr" | jq -r '"\(.author.name) - \(.title) \t \(.web_url)"'
    fi
  done | fzf --delimiter='\t' --with-nth=1 --preview-window hidden | awk -F'\t' '{print $2}' | xargs -r xdg-open
}


myrew() {
  local GITLAB_HOST="gitlab.sima-land.ru" # Если у вас корпоративный GitLab, замените на ваш домен, например "gitlab.company.ru"

  GITLAB_HOST=$GITLAB_HOST glab api "groups/264/merge_requests?state=opened&reviewer_username=misyurov_aa&per_page=100" | \
  jq -c '.[] | select(.work_in_progress == false and .draft == false and (.title | startswith("Draft:") | not))' | \
  while read -r mr; do

    project_id=$(echo "$mr" | jq -r '.project_id' 2>/dev/null)
    mr_iid=$(echo "$mr" | jq -r '.iid' 2>/dev/null)

    # Проверяем наличие вашего апрува в этом конкретном МР
    is_approved=$(GITLAB_HOST=$GITLAB_HOST glab api "projects/$project_id/merge_requests/$mr_iid/approvals" 2>/dev/null | jq --arg user "misyurov_aa" '.approved_by[].user.username == $user' 2>/dev/null | grep true)

    if [ -z "$is_approved" ]; then
      echo "$mr" | jq -r '"\u001b[1;36m    \(.references.full)\u001b[0m\n \u001b[1;35m   \(.author.name)\u001b[0m\n    \u001b[1;37m\(.title)\u001b[0m\n\u001b[34m    \u001b[4m\(.web_url)\u001b[0m\n\u001b[38;5;238m────────────────────────────────────────\u001b[0m"' 2>/dev/null
    fi
  done
}


